# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (must be 3000 in AI Studio preview)
PORT=3000

# SESSION_SECRET: Cryptographic secret for signing session tokens (set a strong random string in production)
SESSION_SECRET="change-this-to-a-strong-random-secret-in-production"

# DB_PATH: Path to SQLite database file
DB_PATH="./database/restaurant.db"

# TIMEZONE: Default restaurant timezone
TZ="Asia/Phnom_Penh"
